{
  "uid": "rackphone-messaging",
  "title": "Rackphone / Messaging",
  "description": "SIM survival and the relay: balance, keepalive, spool.",
  "tags": [
    "rackphone"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "unit",
        "label": "Unit",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "rackphone-prom"
        },
        "definition": "label_values(rackphone_up, unit)",
        "query": {
          "qryType": 1,
          "query": "label_values(rackphone_up, unit)",
          "refId": "unit"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Rackphone",
      "tags": [
        "rackphone"
      ],
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SIM health",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Balance",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rackphone-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rackphone-prom"
          },
          "editorMode": "code",
          "expr": "rackphone_companion_balance",
          "refId": "A",
          "legendFormat": "{{unit}} sub {{sub_id}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "unit": "currencyRUB",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Red below 30 is not a warning but an outage in waiting: a keepalive SMS costs a few roubles, and a SIM that cannot send one is a SIM the operator reclaims."
    },
    {
      "id": 3,
      "title": "Balance last read",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rackphone-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rackphone-prom"
          },
          "editorMode": "code",
          "expr": "rackphone_companion_balance_age_seconds",
          "refId": "A",
          "legendFormat": "{{unit}} sub {{sub_id}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 172800
              },
              {
                "color": "red",
                "value": 259200
              }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "description": "A balance that stopped being refreshed is not a balance. This is what keeps the panel to its left honest."
    },
    {
      "id": 4,
      "title": "Alarms will run",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rackphone-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rackphone-prom"
          },
          "editorMode": "code",
          "expr": "rackphone_companion_battery_exempt",
          "refId": "A",
          "legendFormat": "{{unit}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "dark-blue",
                  "index": 0,
                  "text": "no"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "yes"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Android defers an unopened app's alarms by up to a year. When this is no, the keepalive below is a schedule nobody executes."
    },
    {
      "id": 5,
      "title": "Next keepalive",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rackphone-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rackphone-prom"
          },
          "editorMode": "code",
          "expr": "rackphone_companion_keepalive_seconds_until_due",
          "refId": "A",
          "legendFormat": "{{unit}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "text",
                "value": 1
              }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Time until the earliest SIM is due. Any successful send resets it, so a busy unit shows a full interval and sends nothing extra."
    },
    {
      "id": 6,
      "title": "Targets that resolve to nothing",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rackphone-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rackphone-prom"
          },
          "editorMode": "code",
          "expr": "sum by (unit) (rackphone_companion_keepalive_targets{resolves=\"false\"})",
          "refId": "A",
          "legendFormat": "{{unit}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "A SIM whose own number is not on the card cannot text itself. Everything else about it looks healthy, which is why it is here."
    },
    {
      "id": 7,
      "type": "row",
