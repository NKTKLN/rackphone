    {
      "id": 8,
      "title": "Balance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rackphone-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rackphone-prom"
          },
          "editorMode": "code",
          "expr": "rackphone_companion_balance",
          "refId": "A",
          "legendFormat": "{{unit}} sub {{sub_id}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "currencyRUB",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "pointSize": 8,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "description": "Steps down are sends; a flat line at a low value is a SIM about to stop being able to keep itself alive. Read over 30d."
    },
    {
      "id": 9,
      "type": "row",
      "title": "Delivery",
      "collapsed": false,
