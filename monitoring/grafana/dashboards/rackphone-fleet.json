    {
      "id": 2,
      "title": "Units up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rackphone-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rackphone-prom"
          },
          "editorMode": "code",
          "expr": "sum(rackphone_up)",
          "refId": "A",
          "legendFormat": "up",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rackphone-prom"
          },
          "editorMode": "code",
          "expr": "count(rackphone_up)",
          "refId": "B",
          "legendFormat": "total",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
