# Rackphone unit: lisa01
#
# Declared state for this device. `rackphone deploy` pushes it;
# `rackphone set` updates it alongside the live override so that
# the repo and the hardware do not drift apart.

unit.serial=
unit.label=rack unit 1

battery.max_percent=75
battery.poll_interval=60
companion.keepalive_enabled=1
telemetry.listener_enabled=0
telemetry.thermal_include=^(battery|usb|charger_therm0|quiet_therm|xo-therm-usr|msm-skin-therm-usr|modem-skin-usr|cpuss-[01]-usr|gpuss-[01]-usr|mdmss-[0-3]-usr|nspss-0-usr|ddr-usr|aoss-[01]-usr|video-usr|wifi_therm|pa_therm[01])$
